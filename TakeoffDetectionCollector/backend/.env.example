PORT=
# Comma-separated. Production: your Vercel origin(s). `https://*.vercel.app` covers preview URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://takeoff-detection-collector.vercel.app
ALLOWED_EMAIL_DOMAIN=reflectionwindow.com
DATA_DIR=./data

# Loaded automatically from this file when you `go run` from backend/.
# Leave blank for local in-memory store + Dev sign-in.
# Fill these when you have a dedicated Supabase project.
# DEV_AUTH=true keeps Dev sign-in available while JWT verification is on.
# Production: leave DEV_AUTH unset so Dev sign-in is off.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Concurrent ingest + exclusive job claims (5m after the last heartbeat; tab close releases immediately).
INGEST_WORKERS=16
CLAIM_TTL=5m
DB_MAX_OPEN_CONNS=16
DB_MAX_IDLE_CONNS=8
DEV_AUTH=
